# Arduino's WiFiClientSecure implementation is guarded on this ESP-IDF option.
# Enable the minimal PSK suite set so its TLS client implementation is linked.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
# Required when Arduino is built as an ESP-IDF component.
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
# Required by MicroLink's WireGuard/Noise implementation in the Tailscale build.
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
